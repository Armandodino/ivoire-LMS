# Copie ce fichier en .env puis remplace les valeurs marquées CHANGE_ME.
# scripts/bootstrap.sh le fait pour toi avec des mots de passe aléatoires.
# .env est ignoré par Git — ne le committe jamais.

# ── Moodle ───────────────────────────────────────────────────────────────
MOODLE_WWWROOT=http://localhost:8080
MOODLE_PORT=8080
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=CHANGE_ME
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=CHANGE_ME
MOODLE_ADMIN_EMAIL=admin@ivoire-lms.localhost
MOODLE_SITE_FULLNAME=Ivoire-LMS (développement)
MOODLE_SITE_SHORTNAME=Ivoire-LMS

# ── PostgreSQL ───────────────────────────────────────────────────────────
POSTGRES_PORT=5432

# ── Keycloak (identité unique, jalon 2) ──────────────────────────────────
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# ── Garage (stockage objet compatible S3, remplace MinIO archivé) ────────
# GARAGE_RPC_SECRET doit faire exactement 64 caractères hexadécimaux.
# bootstrap.sh les génère ; ne les remplis pas à la main.
GARAGE_RPC_SECRET=CHANGE_ME_HEX64
GARAGE_ADMIN_TOKEN=CHANGE_ME
GARAGE_S3_PORT=3900
GARAGE_ADMIN_PORT=3903

# ── Mailpit (interception des courriels en dev) ──────────────────────────
MAILPIT_UI_PORT=8025

# ── BigBlueButton (jalon 4) ──────────────────────────────────────────────
# Laisse vide en développement : BBB ne se conteneurise pas, il faut une
# instance dédiée. Voir docs/adr/0003-bigbluebutton-auto-heberge.md.
BBB_SERVER_URL=
BBB_SHARED_SECRET=
